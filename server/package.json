{
  "name": "@solar-management/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "start": "NODE_ENV=production node dist/index.js",
    "db:migrate": "tsx src/db/command.ts migrate",
    "db:seed": "tsx src/db/command.ts seed"
  },
  "dependencies": {
    "@solar-management/shared": "0.1.0",
    "express": "^5.2.1",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.0",
    "supertest": "^7.2.2",
    "tsx": "^4.23.13"
  }
}
